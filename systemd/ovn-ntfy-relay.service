[Unit]
Description=Shrike fleet notification relay (emergency push / hourly-update buffer) - see scripts/ovn_notify.py
After=network-online.target

[Service]
User=mhintermeister
WorkingDirectory=/home/mhintermeister/overnight-queue
Environment=NTFY_TOPIC=shrike_ovn_311380987a
ExecStart=/usr/bin/python3 /home/mhintermeister/overnight-queue/scripts/ovn_notify.py serve --port 8099
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
