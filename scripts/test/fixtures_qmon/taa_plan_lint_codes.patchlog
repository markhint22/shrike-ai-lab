diff --git a/backend/app/utils/plan_lint.py b/backend/app/utils/plan_lint.py
index 0331c01f..dd366ed8 100644
--- a/backend/app/utils/plan_lint.py
+++ b/backend/app/utils/plan_lint.py
@@ -9,0 +10,2 @@ PLAN_LINT_CODES: dict[str, str] = {
+    "blank_test_name": "Test has a blank or missing name",
+    "duplicate_test_name": "Test has a duplicate name",
@@ -12,0 +15,41 @@ PLAN_LINT_CODES: dict[str, str] = {
+def lint_test_names(plan: Any) -> list[dict]:
+    """Lint test names for blank or duplicate entries."""
+    if not isinstance(plan, dict):
+        return []
+
+    tests = plan.get("tests", [])
+    if not isinstance(tests, list):
+        return []
+
+    warnings = []
+    seen_names = {}
+
+    for i, test in enumerate(tests):
+        if not isinstance(test, dict):
+            continue
+
+        name = test.get("name")
+
+        # Check for blank/missing name
+        if not isinstance(name, str) or not name.strip():
+            warnings.append({
+                "code": "blank_test_name",
+                "test_index": i,
+                "message": f"Test at index {i} has a blank or missing name."
+            })
+            continue
+
+        normalized = name.strip().lower()
+
+        # Check for duplicates
+        if normalized in seen_names:
+            warnings.append({
+                "code": "duplicate_test_name",
+                "test_index": i,
+                "message": f"Test at index {i} has a duplicate name: '{name}'."
+            })
+        else:
+            seen_names[normalized] = i
+
+    return warnings
+
@@f886ecd1db896a3496624dfea725f3231e904666|1795436629|fix: restore PLAN_LINT_CODES as dict to fix failing tests

