diff --git a/backend/app/utils/plan_lint.py b/backend/app/utils/plan_lint.py
index dd366ed8..5eb85fb6 100644
--- a/backend/app/utils/plan_lint.py
+++ b/backend/app/utils/plan_lint.py
@@ -2,0 +3 @@ from typing import Any
+from collections import Counter
@@ -55,0 +57,18 @@ def lint_test_names(plan: Any) -> list[dict]:
+
+def lint_summary(warnings: list[dict]) -> dict:
+    """Summarize lint warnings by counting total and grouping by code.
+
+    Args:
+        warnings: List of warning dicts, each containing at least a 'code' key.
+
+    Returns:
+        Dict with 'total' (int) and 'by_code' (dict with sorted keys).
+    """
+    if not warnings:
+        return {"total": 0, "by_code": {}}
+
+    counter = Counter(w.get("code", "unknown") for w in warnings)
+    by_code = dict(sorted(counter.items()))
+
+    return {"total": len(warnings), "by_code": by_code}
+
@@ -97,0 +117,18 @@ def lint_test_contents(plan: Any, max_steps: int = 50) -> list[dict]:
+
+
+def lint_summary(warnings: list[dict]) -> dict:
+    """Summarize lint warnings by counting total and grouping by code.
+
+    Args:
+        warnings: List of warning dicts, each containing at least a 'code' key.
+
+    Returns:
+        Dict with 'total' (int) and 'by_code' (dict with sorted keys).
+    """
+    if not warnings:
+        return {"total": 0, "by_code": {}}
+
+    counter = Counter(w.get("code", "unknown") for w in warnings)
+    by_code = dict(sorted(counter.items()))
+
+    return {"total": len(warnings), "by_code": by_code}
