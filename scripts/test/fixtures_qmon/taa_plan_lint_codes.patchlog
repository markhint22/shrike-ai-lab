diff --git a/backend/app/utils/plan_lint.py b/backend/app/utils/plan_lint.py
index 46e81119..da1720d1 100644
--- a/backend/app/utils/plan_lint.py
+++ b/backend/app/utils/plan_lint.py
@@ -1,0 +2 @@
+from typing import Any
@@ -14,0 +16,44 @@ PLAN_LINT_CODES: dict[str, str] = {
+
+
+def lint_test_contents(plan: Any, max_steps: int = 50) -> list[dict]:
+    """Lint test contents for missing steps/assertions and excessive step counts."""
+    if not isinstance(plan, dict):
+        return []
+
+    tests = plan.get("tests", [])
+    if not isinstance(tests, list):
+        return []
+
+    warnings = []
+    for i, test in enumerate(tests):
+        if not isinstance(test, dict):
+            continue
+
+        steps = test.get("steps")
+        assertions = test.get("assertions")
+
+        # Check for missing or empty steps
+        if not isinstance(steps, list) or len(steps) == 0:
+            warnings.append({
+                "code": "test_without_steps",
+                "test_index": i,
+                "message": f"Test at index {i} has no steps or invalid steps."
+            })
+        else:
+            # Check for too many steps
+            if len(steps) > max_steps:
+                warnings.append({
+                    "code": "many_steps",
+                    "test_index": i,
+                    "message": f"Test at index {i} has {len(steps)} steps (max {max_steps})."
+                })
+
+        # Check for missing or empty assertions
+        if not isinstance(assertions, list) or len(assertions) == 0:
+            warnings.append({
+                "code": "test_without_assertions",
+                "test_index": i,
+                "message": f"Test at index {i} has no assertions or invalid assertions."
+            })
+
+    return warnings
@@725e12f0db9300f28737a02161ee83350d73722a|1795407737|fix(test-automation-agent): repair staged item to pass verification (round 1)

diff --git a/backend/app/utils/plan_lint.py b/backend/app/utils/plan_lint.py
new file mode 100644
index 00000000..46e81119
--- /dev/null
+++ b/backend/app/utils/plan_lint.py
@@ -0,0 +1,14 @@
+"""Plan linting utilities for validating plan documents."""
+
+# Mapping of lint code -> human-readable description.
+# These codes are used to flag issues found in plan documents.
+PLAN_LINT_CODES: dict[str, str] = {
+    "PLAN-001": "Plan is missing a title heading",
+    "PLAN-002": "Plan has no sections or content",
+    "PLAN-003": "Plan references undefined variables or placeholders",
+    "PLAN-004": "Plan contains unresolved TODO items",
+    "PLAN-005": "Plan is missing acceptance criteria",
+    "PLAN-006": "Plan has inconsistent formatting in section headings",
+    "PLAN-007": "Plan references files that do not exist in the repository",
+    "PLAN-008": "Plan contains circular dependencies between tasks",
+}
